# Copie para .env e preencha. O .env nunca vai para o git.
# Chave em console.anthropic.com (defina também um limite de gasto mensal lá)
ANTHROPIC_API_KEY=
# Nome da IA da central
NOME_IA=VZ
# Porta do painel (http://localhost:8790)
PORTA=8790
# Voz premium (opcional): ElevenLabs. Sem isto, a central usa a voz do navegador (no Edge, as vozes "Natural" são as melhores).
ELEVENLABS_API_KEY=
# ID da voz escolhida na Voice Library da ElevenLabs
ELEVENLABS_VOZ=
# Velocidade da fala (0.7 a 1.2)
ELEVENLABS_VELOCIDADE=1
